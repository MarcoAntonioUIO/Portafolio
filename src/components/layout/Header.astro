---
const navItems = [
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#sobre-mi", label: "Sobre mí" },
  { href: "/#contacto", label: "Contacto" },
];
---
<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="MAGV, ir al inicio">
      <span class="brand-mark">M<span>.</span></span>
      <span class="brand-copy">Marco Gómez<small>Desarrollo de Software</small></span>
    </a>
    <nav aria-label="Navegación principal">
      {navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href="mailto:m.antoniocero96@gmail.com">Hablemos <span aria-hidden="true">↗</span></a>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgb(25 27 22 / 8%); background: rgb(247 247 242 / 90%); backdrop-filter: blur(18px); }
  .header-inner { display: flex; min-height: 82px; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; }
  .brand-mark { display: grid; width: 43px; height: 43px; place-items: center; border-radius: 12px; background: var(--color-accent); font-size: 1.1rem; font-weight: 800; letter-spacing: -.08em; }
  .brand-mark span { color: #647b17; }
  .brand-copy { display: grid; font-size: .88rem; font-weight: 800; line-height: 1.25; }
  .brand-copy small { margin-top: .2rem; color: var(--color-muted); font-size: .68rem; font-weight: 500; }
  nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.3rem); }
  .nav-link { color: var(--color-muted); font-size: .88rem; text-decoration: none; transition: color .2s ease; }
  .nav-link:hover { color: var(--color-ink); }
  .header-cta { padding: .65rem 1rem; border: 1px solid var(--color-line); border-radius: 999px; font-size: .84rem; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .header-cta span { margin-left: .3rem; }
  .header-cta:hover { background: var(--color-accent); border-color: var(--color-accent); }
  @media (max-width: 700px) {
    .header-inner { min-height: 72px; gap: .7rem; }
    .brand-copy { display: none; }
    nav { gap: .85rem; }
    .nav-link { font-size: .78rem; }
    .header-cta { padding: .55rem .7rem; font-size: .76rem; }
  }
  @media (max-width: 420px) { nav { gap: .55rem; } .nav-link { font-size: .72rem; } }
</style>
