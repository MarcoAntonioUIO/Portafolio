---
import MainLayout from "@layouts/MainLayout.astro";
import ProjectCard from "@components/portfolio/ProjectCard.astro";
import ProjectFilters from "@components/portfolio/ProjectFilters.astro";
import { projects, featuredProjects } from "@data/projects";
---
<MainLayout
  title="Marco Gómez — Portafolio de desarrollo web"
  description="Proyectos de desarrollo web, aplicaciones y experiencias digitales creadas con atención al diseño, rendimiento y accesibilidad."
>
  <section class="hero container" id="inicio">
    <div class="hero-copy">
      <p class="eyebrow">Desarrollador de software · Quito, Ecuador</p>
      <h1>Construyo experiencias digitales <span>útiles y memorables.</span></h1>
      <p class="hero-description">Diseño y desarrollo sitios web y aplicaciones con una base técnica sólida, interfaces claras y foco en las personas.</p>
      <div class="hero-actions">
        <a class="button" href="#proyectos">Explorar proyectos <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="mailto:m.antoniocero96@gmail.com">Hablemos de tu idea <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-proof">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Disponible para nuevos proyectos y oportunidades</span>
      </div>
    </div>
    <div class="hero-art" aria-label="Composición gráfica abstracta que representa diseño y desarrollo">
      <div class="art-top"><span>IDEAS → INTERFACES</span><span>01 / 26</span></div>
      <div class="art-circle art-circle--one"></div>
      <div class="art-circle art-circle--two"></div>
      <div class="art-cross">+</div>
      <div class="art-caption"><span>Diseño con intención.</span><span>Código con propósito.</span></div>
      <div class="art-chip">ASTRO · TS · WEB</div>
    </div>
    <div class="hero-bottom">
      <span>Scroll para descubrir</span>
      <span class="hero-line"></span>
      <span>01 — Portafolio seleccionado</span>
    </div>
  </section>

  <section class="featured section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Una selección</span>
          <h2 id="featured-title">Proyectos que<br />resuelven cosas reales.</h2>
        </div>
        <p>Una muestra de soluciones digitales: desde sitios de marca hasta herramientas que organizan procesos y conectan personas.</p>
      </div>
      <div class="featured-grid">
        {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="work section" id="proyectos" aria-labelledby="work-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Archivo de trabajo</span>
          <h2 id="work-title">Más ideas,<br />en construcción.</h2>
        </div>
        <p>Explora los proyectos por tipo o sector. Cada ficha explica el reto, el enfoque y las decisiones de desarrollo.</p>
      </div>
      <ProjectFilters />
      <div class="project-grid" id="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <p class="grid-note">Los proyectos marcados como concepto son ejercicios de diseño y no representan clientes reales.</p>
    </div>
  </section>

  <section class="about section" id="sobre-mi" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-number"><span>02</span><span>Sobre mí</span></div>
      <div class="about-content">
        <span class="eyebrow">Pensar · construir · mejorar</span>
        <h2 id="about-title">La tecnología funciona mejor cuando <em>se siente sencilla.</em></h2>
        <p>Me interesa crear productos digitales que sean fáciles de usar y también fáciles de mantener. Combino desarrollo frontend, modelado de datos y una mirada práctica sobre los problemas que cada proyecto necesita resolver.</p>
        <div class="skill-list" aria-label="Áreas de trabajo">
          <span>Frontend</span><span>Astro</span><span>React</span><span>TypeScript</span><span>Node.js</span><span>PostgreSQL</span><span>Accesibilidad</span><span>SEO técnico</span>
        </div>
        <a class="text-link" href="https://github.com/cero96" target="_blank" rel="noreferrer">Ver código en GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="contact section" id="contacto" aria-labelledby="contact-title">
    <div class="container contact-panel">
      <div>
        <span class="eyebrow">Siguiente paso</span>
        <h2 id="contact-title">¿Qué podemos<br /><span>crear juntos?</span></h2>
      </div>
      <div class="contact-action">
        <p>Cuéntame qué necesitas construir, mejorar o resolver. Podemos empezar con una conversación sencilla.</p>
        <a class="button" href="mailto:m.antoniocero96@gmail.com">Escríbeme un correo <span aria-hidden="true">↗</span></a>
      </div>
      <span class="contact-orbit" aria-hidden="true"></span>
    </div>
  </section>
</MainLayout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); min-height: min(760px, calc(100svh - 82px)); padding-top: 5rem; padding-bottom: 7rem; }
  .hero h1 { max-width: 760px; margin: 1.3rem 0; font-size: clamp(3.2rem, 7.3vw, 6.9rem); line-height: .96; letter-spacing: -.085em; font-weight: 700; }
  .hero h1 span { color: #777c6b; }
  .hero-description { max-width: 550px; color: var(--color-muted); font-size: clamp(1rem, 1.6vw, 1.2rem); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.3rem; margin-top: 2rem; }
  .text-link { display: inline-flex; align-items: center; gap: .6rem; font-size: .9rem; font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .text-link span { transition: transform .2s ease; }
  .text-link:hover span { transform: translate(3px, -3px); }
  .hero-proof { display: flex; align-items: center; gap: .6rem; margin-top: 3.4rem; color: var(--color-muted); font-size: .75rem; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #77951f; box-shadow: 0 0 0 5px rgb(119 149 31 / 13%); }
  .hero-art { position: relative; min-height: 470px; overflow: hidden; border-radius: 22px; background: #e9e9df; isolation: isolate; }
  .art-top, .art-caption { position: absolute; z-index: 3; right: 1.3rem; left: 1.3rem; display: flex; justify-content: space-between; gap: 1rem; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .06em; }
  .art-top { top: 1.3rem; }
  .art-caption { bottom: 1.4rem; flex-direction: column; font-family: var(--font-body); font-size: .85rem; font-weight: 700; letter-spacing: 0; }
  .art-circle { position: absolute; border-radius: 50%; }
  .art-circle--one { top: 16%; left: 16%; width: 70%; aspect-ratio: 1; background: var(--color-accent); }
  .art-circle--two { top: 28%; left: 33%; width: 48%; aspect-ratio: 1; border: 1px solid #171914; background: repeating-linear-gradient(135deg, transparent 0 8px, rgb(23 25 20 / 17%) 8px 9px); }
  .art-cross { position: absolute; top: 38%; left: 48%; z-index: 2; color: #171914; font-size: 6rem; font-weight: 400; line-height: 1; transform: translate(-50%, -50%); }
  .art-chip { position: absolute; right: 1.2rem; bottom: 6.3rem; z-index: 3; padding: .5rem .7rem; border-radius: 999px; background: #171914; color: white; font-family: var(--font-mono); font-size: .65rem; transform: rotate(-6deg); }
  .hero-bottom { position: absolute; right: 1.5rem; bottom: 2rem; left: 1.5rem; display: flex; align-items: center; gap: 1rem; color: var(--color-muted); font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .hero-line { flex: 1; height: 1px; background: var(--color-line); }
  .featured { background: #efefe8; }
  .featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.2rem, 3vw, 2.4rem); }
  .work { background: var(--color-paper); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.2rem 1.5rem; }
  .grid-note { margin: 2rem 0 0; color: var(--color-muted); font-size: .75rem; }
  .about { background: var(--color-accent); }
  .about-grid { display: grid; grid-template-columns: .35fr 1fr; gap: 3rem; }
  .about-number { display: flex; flex-direction: column; gap: .5rem; font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; }
  .about-content { max-width: 850px; }
  .about-content h2 { margin: 1rem 0 1.4rem; font-size: clamp(2.5rem, 6vw, 5.5rem); line-height: .98; letter-spacing: -.075em; }
  .about-content h2 em { font-style: normal; color: #687d24; }
  .about-content > p { max-width: 650px; color: #424638; font-size: 1.05rem; }
  .skill-list { display: flex; flex-wrap: wrap; gap: .6rem; margin: 2rem 0; }
  .skill-list span { padding: .55rem .8rem; border: 1px solid rgb(25 27 22 / 25%); border-radius: 999px; font-size: .78rem; font-weight: 700; }
  .contact { padding-top: 3rem; }
  .contact-panel { position: relative; display: flex; align-items: end; justify-content: space-between; gap: 3rem; overflow: hidden; padding: clamp(2rem, 6vw, 5rem); border-radius: 22px; background: #20221b; color: white; isolation: isolate; }
  .contact-panel h2 { position: relative; z-index: 1; margin: 1rem 0 0; font-size: clamp(3rem, 7vw, 6.4rem); line-height: .94; letter-spacing: -.08em; }
  .contact-panel h2 span { color: var(--color-accent); }
  .contact-action { position: relative; z-index: 1; max-width: 310px; }
  .contact-action p { color: #c7c9bf; }
  .contact-orbit { position: absolute; z-index: 0; right: 5%; top: -35%; width: 300px; aspect-ratio: 1; border: 1px solid rgb(216 250 99 / 24%); border-radius: 50%; box-shadow: 0 0 0 35px rgb(216 250 99 / 5%), 0 0 0 75px rgb(216 250 99 / 4%); }
  @media (max-width: 850px) { .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 4rem; } .hero-art { min-height: 420px; } .hero-bottom { bottom: 1rem; } .about-grid { grid-template-columns: 1fr; gap: 2rem; } .about-number { flex-direction: row; justify-content: space-between; } .contact-panel { align-items: start; flex-direction: column; } }
  @media (max-width: 600px) { .hero h1 { font-size: clamp(3rem, 15vw, 5rem); } .hero-art { min-height: 340px; } .featured-grid, .project-grid { grid-template-columns: 1fr; } .hero-bottom { right: 0; left: 0; } .hero-bottom span:last-child { display: none; } .hero-line { display: none; } .hero-bottom { justify-content: center; } .contact-panel { gap: 1rem; } }
</style>
